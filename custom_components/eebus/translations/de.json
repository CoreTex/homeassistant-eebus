    "trust_device": {
      "name": "Gerät vertrauen",
      "description": "Einem EEBUS-Gerät per SKI vertrauen, damit es sich mit der Bridge koppeln kann. Das Vertrauen wird vom Add-on gespeichert.",
      "fields": {
        "ski": { "name": "SKI", "description": "Der 40-stellige hexadezimale SKI des Geräts." }
      }
    },
    "forget_device": {
      "name": "Gerät vergessen",
