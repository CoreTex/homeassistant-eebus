      "fields": {
        "ski": { "name": "SKI", "description": "Der 40-stellige hexadezimale SKI des Geräts." }
      }
    },
    "set_device_limit": {
      "name": "Gerätelimit setzen",
      "description": "Verbrauchs- (LPC) oder Erzeugungslimit (LPP) für ein EEBUS-Gerät setzen und/oder anwenden, z. B. Wärmepumpe oder Wallbox dimmen. Erfordert enable_eg_control im Add-on.",
      "fields": {
        "device_id": { "name": "Gerät", "description": "Das EEBUS-Gerät (Wechselrichter, Wallbox, Wärmepumpe, ...)." },
        "ski": { "name": "SKI", "description": "Alternativ der 40-stellige SKI des Geräts." },
        "kind": { "name": "Art", "description": "consumption (LPC) oder production (LPP)." },
        "value_w": { "name": "Limit", "description": "Limit in Watt. Weglassen, um den Wert zu behalten." },
        "active": { "name": "Aktiv", "description": "Limit anwenden (true) oder aufheben (false). Weglassen, um nur den Wert vorzumerken." },
        "duration_s": { "name": "Dauer", "description": "Dauer in Sekunden (0 = bis zur Aufhebung)." }
      }
    },
    "simulate_grid_limit": {
      "name": "Netzbetreiber-Limit simulieren (§14a)",
      "description": "NUR ZUM TESTEN: ein eingehendes §14a-Verbrauchslimit des Netzbetreibers simulieren, als hätte eine Steuerbox es gesendet. Läuft durch die normale Verteilung und endet nach der Dauer. Erfordert enable_lpc_simulation im Add-on und wird verweigert, solange eine echte Steuerbox verbunden oder ein echtes Limit aktiv ist.",
      "fields": {
        "value_w": { "name": "Limit", "description": "Gesamt-Verbrauchslimit in Watt." },
        "active": { "name": "Aktiv", "description": "Simulation starten (true) oder beenden (false)." },
        "duration_s": { "name": "Dauer", "description": "Dauer in Sekunden (0 = bis zum Beenden)." }
      }
    }
