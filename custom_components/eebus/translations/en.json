{
  "config": {
    "step": {
      "user": {
        "title": "EEBUS Bridge",
        "description": "Enter the address of the EEBUS Bridge add-on API. With the bundled add-on (host network) use your Home Assistant host IP.",
        "data": {
          "host": "Host",
          "port": "Port",
          "token": "API token (optional)"
        }
      }
    },
    "error": {
      "cannot_connect": "Failed to connect to the EEBUS Bridge API.",
      "no_ski": "The add-on did not report a SKI yet. Make sure it has finished starting."
    },
    "abort": {
      "already_configured": "This EEBUS Bridge is already configured."
    }
  },
  "services": {
    "set_consumption_limit": {
      "name": "Set consumption limit",
      "description": "Send an LPC consumption limit to the inverter (Home Assistant acting as Energy Guard).",
      "fields": {
        "value_w": { "name": "Limit", "description": "Consumption limit in watts." },
        "active": { "name": "Active", "description": "Whether the limit is active." },
        "duration_s": { "name": "Duration", "description": "Duration in seconds (0 = no time limit)." }
      }
    },
    "set_production_limit": {
      "name": "Set production limit",
      "description": "Send an LPP production limit to the inverter (Home Assistant acting as Energy Guard).",
      "fields": {
        "value_w": { "name": "Limit", "description": "Production limit in watts (positive value)." },
        "active": { "name": "Active", "description": "Whether the limit is active." },
        "duration_s": { "name": "Duration", "description": "Duration in seconds (0 = no time limit)." }
      }
    },
    "trust_device": {
      "name": "Trust device",
      "description": "Trust a remote EEBUS device by its SKI so it can pair with the bridge. The trust is persisted by the add-on.",
      "fields": {
        "ski": { "name": "SKI", "description": "The 40-character hexadecimal SKI of the remote device." }
      }
    },
    "forget_device": {
      "name": "Forget device",
      "description": "Remove the trust for a remote EEBUS device. SKIs listed in the add-on configuration are trusted again after an add-on restart.",
      "fields": {
        "ski": { "name": "SKI", "description": "The 40-character hexadecimal SKI of the remote device." }
      }
    },
    "set_device_limit": {
      "name": "Set device limit",
      "description": "Set and/or apply a consumption (LPC) or production (LPP) limit on one EEBUS device, e.g. dim a heat pump or wallbox. Requires enable_eg_control in the add-on.",
      "fields": {
        "device_id": { "name": "Device", "description": "The EEBUS device (inverter, wallbox, heat pump, ...)." },
        "ski": { "name": "SKI", "description": "Alternatively the 40-character SKI of the device." },
        "kind": { "name": "Kind", "description": "consumption (LPC) or production (LPP)." },
        "value_w": { "name": "Limit", "description": "Limit in watts. Omit to keep the current value." },
        "active": { "name": "Active", "description": "Apply (true) or remove (false) the limit. Omit to only stage the value." },
        "duration_s": { "name": "Duration", "description": "Duration in seconds (0 = until removed)." }
      }
    }
  },
